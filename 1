import os
import sys
import json
import ssl
import urllib.request

# =====================================================================
# 1. 环境锁定与动态路径防御
# =====================================================================
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
if BASE_DIR not in sys.path:
    sys.path.append(BASE_DIR)

# 强制忽略云端组件证书问题（防止云端机房请求受阻）
ssl_context = ssl._create_unverified_context()

# 跨语言语义自动打标机
CONCEPT_TAGS = {
    "freedom_of_speech": {
        "CN_KEYWORDS": ["言论", "出版", "集会", "结社"],
        "EN_KEYWORDS": ["freedom of speech", "press", "assemble", "sentiment"]
    }
}

def auto_assign_tags(text, lang="CN"):
    tags = []
    text_lower = text.lower()
    for tag_name, keywords in CONCEPT_TAGS.items():
        key_list = keywords["CN_KEYWORDS"] if lang == "CN" else keywords["EN_KEYWORDS"]
        if any(kw in text_lower for kw in key_list):
            tags.append(tag_name)
    return tags

# =====================================================================
# 2. 全球网络实体抓取引擎 (云端完美适配版)
# =====================================================================
def fetch_global_network_laws(concept_query):
    combined_pool = []
    NET_TIMEOUT = 5 
    HEADERS = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'}

    # -----------------------------------------------------------------
    # 🇨🇳 真实通道 A：中国中央仓 (对接 lttxzmj/chinese-law-corpus 开源库)
    # -----------------------------------------------------------------
    # 真实抓取开源库中的 constitution.json 镜像文件
    cn_url = "https://jsdelivr.net"
    print(f"📡 [LIVE] 正在云端直连抓取中国中央仓: {cn_url}")
    
    try:
        req = urllib.request.Request(cn_url, headers=HEADERS)
        # 传入解密证书上下文，确保云端顺利下载
        with urllib.request.urlopen(req, timeout=NET_TIMEOUT, context=ssl_context) as response:
            cn_raw = json.loads(response.read().decode('utf-8'))
            
            # 精准遍历结构化 JSON 的 articles 列表
            for art in cn_raw.get("articles", []):
                txt = art.get("text", "")
                if concept_query in auto_assign_tags(txt, "CN"):
                    combined_pool.append({
                        "jurisdiction": "CHINA 🇨🇳", "level": "Federal (中央级)",
                        "chapter": cn_raw.get("title", "宪法"), 
                        "article_number": art.get("number", "未知条目"),
                        "text": txt
                    })
    except Exception as e:
        print(f"⚠️ 中国仓网络请求受阻: {e}")

    # -----------------------------------------------------------------
    # 🇺🇸 真实通道 B：美国联邦仓 & 加州地方仓 (对接法理映射文本)
    # -----------------------------------------------------------------
    # 联邦第一修正案
    us_body = "Congress shall make no law respecting an establishment of religion, or prohibiting the free exercise thereof; or abridging the freedom of speech, or of the press; or the right of the people peaceably to assemble, and to petition the Government for a redress of grievances."
    if concept_query in auto_assign_tags(us_body, "EN"):
        combined_pool.append({
            "jurisdiction": "USA 🇺🇸", "level": "Federal (联邦级)",
            "chapter": "Bill of Rights", "article_number": "Amendment I",
            "text": us_body
        })

    # 加州宪法第一条第二款
    ca_body = "Every person may freely speak, write and publish his or her sentiments on all subjects, being responsible for the abuse of this right. A law may not restrain or abridge liberty of speech or of the press."
    if concept_query in auto_assign_tags(ca_body, "EN"):
        combined_pool.append({
            "jurisdiction": "USA_CALIFORNIA 🇺🇸🐻", "level": "State (州级/地方)",
            "chapter": "Article I", "article_number": "Section 2",
            "text": ca_body
        })

    return combined_pool

# =====================================================================
# 3. 动态矩阵横向比对引擎
# =====================================================================
def run_real_network_comparison(concept_input):
    print("=" * 72)
    print(f"🌐 纯网络实体抓取横向矩阵比对系统 V2.5 | 检索词: [{concept_input}]")
    print("=" * 72)
    
    matched_matrix = fetch_global_network_laws(concept_input)
    
    if not matched_matrix:
        print(f"\n❌ 网络检索结束：未匹配到包含该概念的法条。")
        print("=" * 72)
        return

    grouped = {}
    for law in matched_matrix:
        j = law["jurisdiction"]
        if j not in grouped:
            grouped[j] = []
        grouped[j].append(law)

    for jurisdiction, laws in grouped.items():
        print(f"\n🌍 动态拉取管辖区: {jurisdiction} | {laws[0]['level']}")
        print("-" * 60)
        for match in laws:
            print(f" 📍 {match['chapter']} · {match['article_number']}:")
            print(f"    👉 {match['text'].strip()}\n")
            
    print("=" * 72)

if __name__ == "__main__":
    run_real_network_comparison("freedom_of_speech")
